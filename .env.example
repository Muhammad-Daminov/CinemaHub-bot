# --- App ---
ENVIRONMENT=development
DEBUG=true
PORT=8000

# --- Database: NeonDB (Postgres). Use the pooled connection string,
# and keep sslmode=require. Driver must be asyncpg. ---
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-pooler-host>/<dbname>?ssl=require

# --- Redis (Upstash/Redis Cloud/etc.) ---
REDIS_URL=redis://default:<password>@<redis-host>:<port>/0

# --- Telegram Bot ---
BOT_TOKEN=<telegram-bot-token>
WEBHOOK_BASE_URL=https://<your-app>.onrender.com
WEBHOOK_SECRET=<random-long-secret-string>

# --- Third-party APIs ---
TMDB_API_KEY=<tmdb-api-key>
GEMINI_API_KEY=<gemini-api-key>

# --- Business rules ---
AI_DAILY_LIMIT_FREE=3
